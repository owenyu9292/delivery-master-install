{
  "name": "delivery-master-install",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx scripts/run-domain-tests.ts",
    "test:platform": "tsx scripts/run-platform-tests.ts",
    "test:sqlite": "tsx scripts/run-sqlite-store-tests.ts",
    "test:runtime": "tsx scripts/run-runtime-selection-tests.ts",
    "test:handling": "tsx scripts/run-handling-tests.ts",
    "test:storage-safety": "tsx scripts/run-storage-safety-tests.ts",
    "test:sqlite-file": "tsx scripts/run-native-sqlite-safety-tests.ts",
    "test:correction-safety": "tsx scripts/run-correction-safety-tests.ts",
    "test:zone-identity": "tsx scripts/run-zone-identity-tests.ts",
    "test:time-links": "tsx scripts/run-time-links-tests.ts",
    "test:auto-cleanup": "tsx scripts/run-auto-cleanup-tests.ts",
    "test:time-stress": "tsx scripts/run-time-stress-tests.ts",
    "test:helper-restore": "tsx scripts/run-helper-restore-tests.ts",
    "test:statistics": "tsx scripts/run-statistics-tests.ts",
    "check": "npm run typecheck && npm run test && npm run test:platform && npm run test:sqlite && npm run test:runtime && npm run test:handling && npm run test:storage-safety && npm run test:sqlite-file && npm run test:correction-safety && npm run test:zone-identity && npm run test:time-links && npm run test:auto-cleanup && npm run test:time-stress && npm run test:helper-restore && npm run test:statistics",
    "check:handling": "node scripts/browser-handling.mjs",
    "check:field": "node scripts/browser-field-workflow.mjs",
    "check:browser": "node scripts/run-browser-checks.mjs",
    "check:codex": "node scripts/codex-precommit-check.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-app.mjs",
    "serve": "node scripts/serve-dist.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "lucide": "^1.43.0"
  }
}
